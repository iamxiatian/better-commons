<configurations>
    <!--  配置模板  -->
    <property>
        <name>api.server.host</name>
        <value>0.0.0.0</value>
        <description>API服务器地址</description>
    </property>

    <property>
        <name>api.server.port</name>
        <value>8080</value>
        <description>API服务端口</description>
    </property>

    <!--  增deepseek-v4-flash接口相关配置-start  -->
    <property>
        <name>llm.deepseek_v4_flash.api.base</name>
        <value>http://www.yourserver.com/openAi/v1</value>
        <description>deepseek_v4_flash的API访问路径，需要替换为真实地址</description>
    </property>

    <property>
        <name>llm.deepseek_v4_flash.model.path</name>
        <value>deepseek-v4-flash</value>
        <description>deepseek_v4_flash的模型名称</description>
    </property>

    <property>
        <name>llm.deepseek_v4_flash.authorization_key</name>
        <value>your_key</value>
        <description>deepseek_v4_flash的Authorization的值</description>
    </property>

</configurations>
